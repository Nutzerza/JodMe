// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECT_URL")
  // url      = env("DATABASE_URL")
}

enum AnimeStatus {
  PLANNING
  WATCHING
  COMPLETED
  DROPPED
  ON_HOLD
}

model MapUserUid {
  id  Int    @unique
  uid String @unique

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model MapAnimeUid {
  id  Int    @unique
  uid String @unique

  anime Anime @relation(fields: [id], references: [id], onDelete: Cascade)
}

model User {
  id           Int     @id @default(autoincrement())
  username     String? @unique
  email        String  @unique
  image        String?
  passwordHash String?

  resetToken       String?
  resetTokenExpiry DateTime?

  animeList  UserAnime[]
  mapUserUid MapUserUid?

  createdAt    DateTime       @default(now())
  watchHistory WatchHistory[]
}

model Anime {
  id        Int @id @default(autoincrement())
  anilistId Int @unique

  title        String
  description  String? @db.Text
  coverImage   String
  trailer      String? // URL ของ trailer (ถ้ามี)
  episodes     Int?
  season       String?
  seasonOrder  Int? // 1-4 สำหรับ WINTER-SPRING-SUMMER-FALL
  year         Int?
  averageScore Float?
  status       String?

  genres String[] // PostgreSQL array (Supabase ใช้ได้)
  studio String?

  // cache จาก API
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  users        UserAnime[]
  mapAnimeUid  MapAnimeUid?
  watchHistory WatchHistory[]

  @@index([anilistId])
}

model UserAnime {
  // id Int @id @default(autoincrement())

  userId  Int
  animeId Int

  status   AnimeStatus @default(PLANNING)
  score    Int?
  progress Int         @default(0)

  startDate  DateTime?
  finishDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@id([userId, animeId])
}

model WatchHistory {
  id Int @id @default(autoincrement())

  userId  Int
  animeId Int

  episode   Int
  watchedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  anime Anime @relation(fields: [animeId], references: [id], onDelete: Cascade)

  @@index([userId, watchedAt])
}
